<script>
  // "Open now" indicator from opening hours (local time).
  // Mon–Fri 8–20, Sat 9–17, Sun 9–13.
  const schedule = {
    0: [9, 13], // Sun
    1: [8, 20], 2: [8, 20], 3: [8, 20], 4: [8, 20], 5: [8, 20],
    6: [9, 17], // Sat
  };
  const now = new Date();
  const day = now.getDay();
  const hour = now.getHours() + now.getMinutes() / 60;
  const [open, close] = schedule[day];
  const isOpen = hour >= open && hour < close;
  const fmt = (h) => {
    const hr = h % 12 === 0 ? 12 : h % 12;
    return `${hr}${h < 12 ? 'am' : 'pm'}`;
  };
  const statusEl = document.getElementById('open-status');
  const todayEl = document.getElementById('open-today');
  const dotEl = document.getElementById('open-dot');
  if (statusEl && todayEl && dotEl) {
    if (isOpen) {
      statusEl.textContent = 'Open now';
      todayEl.textContent = `Until ${fmt(close)} today`;
    } else {
      statusEl.textContent = 'Open 7 days';
      todayEl.textContent = `Today ${fmt(open)}–${fmt(close)}`;
      dotEl.setAttribute('data-closed', '');
    }
  }

  // ---- Reveal on scroll ----------------------------------------------------
  // Cards float and fade up once as the section enters view. Anything the
  // observer cannot reach stays visible, so content never depends on JS.
  const revealEls = document.querySelectorAll('.reveal');
  const motionOk = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (revealEls.length && motionOk && 'IntersectionObserver' in window) {
    document.documentElement.classList.add('js-reveal');

    const showAll = () => revealEls.forEach((el) => el.classList.add('is-in'));
    // Failsafe: if the observer never reports (some embedded webviews), show
    // everything rather than leave the section blank.
    const failsafe = setTimeout(showAll, 2500);

    let reported = false;
    const io = new IntersectionObserver(
      (entries) => {
        if (!reported) {
          reported = true;
          clearTimeout(failsafe);
        }
        entries.forEach((entry) => {
          const targets = entry.target.hasAttribute('data-reveal-group')
            ? entry.target.querySelectorAll('.reveal')
            : [entry.target];
          targets.forEach((el) => el.classList.toggle('is-in', entry.isIntersecting));
        });
      },
      { rootMargin: '0px 0px -12% 0px', threshold: 0.05 }
    );

    const groups = document.querySelectorAll('[data-reveal-group]');
    groups.forEach((g) => io.observe(g));
    revealEls.forEach((el) => {
      if (!el.closest('[data-reveal-group]')) io.observe(el);
    });
    window.addEventListener('pagehide', () => clearTimeout(failsafe), { once: true });
  }
</script>
