---
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Stars from '../components/Stars.astro';
import Motif from '../components/Motif.astro';
import {
  practice,
  hours,
  quickAccess,
  whyMgp,
  doctors,
  serviceGroups,
  specialistClinics,
  partnerClinics,
  reviews,
} from '../data/site.js';

const roofServices = ['GP', 'Pathology', 'Pharmacy', 'Radiology', 'Skin clinic'];

const mapEmbed = `https://www.google.com/maps?q=${encodeURIComponent(
  practice.mapQuery
)}&z=16&output=embed`;
---

<Layout>
  <a href="#main" class="skip-link">Skip to content</a>
  <span id="top"></span>
  <Header />

  <main id="main">
    <!-- ===== HERO ===== -->
    <section class="hero hero-animate">
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <h1>All your healthcare needs <span class="hl">under one roof</span></h1>
          <p class="lead">GP, pathology, radiology and skin clinic in the same building.</p>

          <ul class="hero-points">
            <li><Icon name="iconoir:check" /> Open 7 days</li>
            <li><Icon name="iconoir:check" /> After-hours available</li>
            <li><Icon name="iconoir:check" /> Same day appointments</li>
          </ul>

          <div class="hero-actions">
            <a class="btn btn-primary" href={practice.bookingUrl} target="_blank" rel="noopener">
              <Icon name="iconoir:calendar-plus" /> Book online
            </a>
            <a class="btn btn-secondary" href={practice.phoneHref}>
              <Icon name="iconoir:phone" /> {practice.phone}
            </a>
          </div>

          <div class="hero-badges">
            <span class="badge badge-google">
              <img src="/assets/google-icon.png" alt="Google" width="26" height="26" />
              <Icon name="iconoir:star-solid" class="badge-star" />
              <strong>{practice.rating}</strong>
              <span class="badge-reviews">{practice.reviewCount}<br />Reviews</span>
            </span>
            <span class="badge badge-teaching">
              <span class="badge-teaching-label">Teaching<br />practice</span>
              <img src="/assets/UoM-logo.png" alt="University of Melbourne" />
              <img src="/assets/RACGP-logo.png" alt="RACGP" />
            </span>
          </div>
        </div>
      </div>
      <img
        class="hero-photo"
        src="/assets/hero-banner.webp"
        alt=""
        width="980"
        height="731"
        fetchpriority="high"
        decoding="async"
      />
    </section>

    <!-- ===== QUICK ACCESS — below the fold, not crowding hero ===== -->
    <section class="quick section" aria-labelledby="quick-h">
      <div class="wrap">
        <h2 id="quick-h" class="quick-h">What do you need today?</h2>
        <ul class="quick-grid">
          {quickAccess.map((q) => {
            const href = q.href === 'BOOKING' ? practice.bookingUrl : q.href;
            const ext = q.href === 'BOOKING';
            return (
              <li>
                <a href={href} class="quick-tile" {...(ext ? { target: '_blank', rel: 'noopener' } : {})}>
                  <span class="quick-medallion"><Icon name={q.icon} /></span>
                  <span class="quick-text">
                    <span class="quick-label">{q.label}</span>
                    <span class="quick-desc">{q.desc}</span>
                    <span class="quick-arrow" aria-hidden="true"><Icon name="iconoir:arrow-right" /></span>
                  </span>
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    </section>

    <!-- ===== OPEN WHEN YOU NEED US — navy anchor ===== -->
    <section class="hours-sec section" id="hours" aria-labelledby="hours-h">
      <div class="wrap hours-grid">
        <div class="hours-lead">
          <h2 id="hours-h">Open when you need us &mdash; <span class="hl">7 days a week</span></h2>
          <p class="lead">
            The doctors consulting from MGP provide comprehensive care 7 days a week, including
            dedicated After Hours Care. MGP makes provision for 24-hour care from your doctor for
            urgent medical problems.
          </p>
          <div class="hours-flags">
            <span class="flag"><Icon name="iconoir:flash" /> Same-day appointments</span>
            <span class="flag"><Icon name="iconoir:half-moon" /> After-hours care</span>
          </div>
          <p class="billing-line">
            MGP is mainly a private billing practice, with some items and concession visits bulk
            billed. <a href="#billing">See fees &amp; billing</a>.
          </p>
        </div>
        <div class="hours-card">
          <h3>Opening hours</h3>
          <ul class="hours-list">
            {hours.map((h) => (
              <li><span>{h.day}</span><span class="hours-time">{h.time}</span></li>
            ))}
          </ul>
          <a href={practice.bookingUrl} class="btn btn-primary btn-block" target="_blank" rel="noopener">
            <Icon name="iconoir:calendar-plus" /> Book online
          </a>
        </div>
      </div>
    </section>

    <!-- ===== WHY MGP ===== -->
    <section class="why section" aria-labelledby="why-h">
      <div class="wrap why-wrap">
        <div class="section-head">
          <h2 id="why-h">More than a referral. We treat it here.</h2>
          <p class="lead">One practice for the whole family — comprehensive care, on site.</p>

          {/* [CONFIRM] "Contact us" points at the location band; swap for a
              dedicated contact page once one exists. */}
          <div class="why-cta">
            <a href={practice.bookingUrl} class="btn btn-primary" target="_blank" rel="noopener">
              <Icon name="iconoir:calendar-plus" /> Book online
            </a>
            <a href="#location" class="btn btn-secondary">
              <Icon name="iconoir:phone" /> Contact us
            </a>
          </div>
        </div>
        <div class="why-grid">
          {whyMgp.map((w) => (
            <div class="why-item">
              <div class="why-bleed" aria-hidden="true">
                <span class="wb wb-navy"></span>
                <span class="wb wb-blue"></span>
                <span class="wb wb-amber"></span>
              </div>
              <span class="why-ico"><Icon name={w.icon} /></span>
              <h3>{w.title}</h3>
              <p>{w.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ===== SERVICES ===== -->
    <section class="services-sec surface-white section" id="services" aria-labelledby="services-h">
      <div class="wrap">
        <div class="section-head services-head">
          <img class="services-motif" src="/assets/motif-variation.png" alt="" width="120" height="66" />
          <div>
            <h2 id="services-h"><span class="hl">One practice</span>, every service</h2>
            <p class="lead">Book what you need, when you need it.</p>
          </div>
        </div>
        {serviceGroups.map((g) => (
          <section class="svc-group" aria-labelledby={`sg-${g.title.replace(/\W+/g, '-').toLowerCase()}`}>
            <div class="sg-head">
              <Motif color="#f36223" size="1.5625rem" />
              <h3 id={`sg-${g.title.replace(/\W+/g, '-').toLowerCase()}`}>{g.title}</h3>
            </div>
            <ul class="svc-cards">
              {g.items.map((it) => (
                <li>
                  <a class="svc-card" href={it.href}>
                    <img
                      class="svc-img"
                      src={`/assets/services/${it.img}.webp`}
                      alt=""
                      width="480"
                      height="270"
                      loading="lazy"
                      decoding="async"
                    />
                    <span class="svc-label">
                      <span class="svc-ico"><Icon name={it.icon} /></span>
                      <span class="svc-name">{it.name}</span>
                      <Icon name="iconoir:arrow-right" />
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}

      </div>

      <!-- Specialist clinics deliberately break the page wrap: icon-led colour
           tiles running to a 40px margin off each edge. -->
      <section class="svc-group spec-group" aria-labelledby="specialist-h">
        <div class="wrap">
          <div class="sg-head">
            <Motif color="#3fc8a9" size="1.5625rem" />
            <h3 id="specialist-h">{specialistClinics.title}</h3>
          </div>
        </div>
        <ul class="spec-cards">
            {specialistClinics.items.map((it) => (
              <li>
                <article class={`spec-card spec-${it.tone}`}>
                  <span class="spec-ico" aria-hidden="true"><Icon name={it.icon} /></span>
                  <h4 class="spec-name">{it.name}</h4>
                  <p class="spec-body">{it.body}</p>
                  <div class="spec-actions">
                    <a class="link-cta" href={practice.bookingUrl} target="_blank" rel="noopener">
                      Book now <Icon name="iconoir:arrow-up-right" />
                    </a>
                    <a class="btn btn-primary btn-sm" href={it.href}>Learn more</a>
                  </div>
                </article>
              </li>
            ))}
        </ul>
      </section>

      <div class="wrap">

        <!-- Partner clinics are separate businesses in the Centre: own layout,
             own visual register, and every link leaves the site. -->
        <section class="partners" aria-labelledby="partners-h">
          <div class="sg-head">
            <Motif color="#e259c9" size="1.5625rem" />
            <h3 id="partners-h">{partnerClinics.title}</h3>
          </div>
          <ul class="partner-list">
            {partnerClinics.items.map((it) => (
              <li>
                <article class="partner-card">
                  <img
                    class="partner-img"
                    src={`/assets/services/${it.img}.webp`}
                    alt=""
                    width="480"
                    height="320"
                    loading="lazy"
                    decoding="async"
                  />
                  <div class="partner-body">
                    <span class="partner-ico" aria-hidden="true"><Icon name={it.icon} /></span>
                    <div class="partner-row">
                      <div class="partner-copy">
                        <h4 class="partner-name">{it.name}</h4>
                        <p class="partner-blurb">{it.blurb}</p>
                      </div>
                      <a class="btn btn-primary btn-sm" href={it.href} target="_blank" rel="noopener">
                        Visit now
                      </a>
                    </div>
                  </div>
                </article>
              </li>
            ))}
          </ul>
        </section>
      </div>
    </section>

    <!-- ===== CARE IN YOUR LANGUAGE ===== -->
    <section class="doctors-sec section" id="doctors" aria-labelledby="doctors-h">
      <div class="wrap">
        <div class="section-head">
          <h2 id="doctors-h">Care in your language</h2>
          <p class="lead">
            Our doctors span a wide range of fields. Find the right one, in the language you're
            most comfortable with.
          </p>
        </div>

        <ul class="doctor-grid">
          {doctors.slice(0, 8).map((d) => (
            <li>
              {/* [CONFIRM] doctor profile page slugs before publishing. */}
              <a class="doc-card" href={`/doctors/${d.name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}`}>
                <span class="doc-top">
                <img
                  class="doc-photo"
                  src={d.photo === false
                    ? '/assets/doctor-placeholder.svg'
                    : `/assets/doctors/${d.name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}.webp`}
                  alt=""
                  width="56"
                  height="56"
                  loading="lazy"
                  decoding="async"
                />
                {d.langs && (
                  <span class="doc-lang"><span class="doc-hello">{d.hello}!</span> {d.langs}</span>
                )}
                </span>
                <span class="doc-info">
                  <span class="doc-name">{d.name}</span>
                  <span class="doc-more link-cta link-cta-navy">View profile <Icon name="iconoir:arrow-up-right" /></span>
                </span>
              </a>
            </li>
          ))}
        </ul>

        {/* [CONFIRM] full doctor listing page slug before publishing. */}
        <div class="doctors-more">
          <a href="/doctors" class="btn btn-primary">More doctors</a>
        </div>
      </div>
    </section>

    <!-- ===== BILLING ===== -->
    <section class="billing-sec surface-blue-tint section" id="billing" aria-labelledby="billing-h">
      <div class="wrap billing-inner">
        <img
          class="billing-img"
          src="/assets/billing-mygov.webp"
          alt=""
          width="1011"
          height="727"
          loading="lazy"
          decoding="async"
        />
        <div class="billing-copy">
          <span class="billing-ico"><Icon name="iconoir:wallet" /></span>
          <h2 id="billing-h">Billing, explained simply</h2>
          <p class="lead">
            MGP is mainly a private billing practice, with some items and concession visits bulk
            billed. See what a standard appointment costs and what Medicare rebates back — so there
            are no surprises.
          </p>
          <a href="/fees" class="btn btn-primary"><Icon name="iconoir:wallet" /> See our fees</a>
          <!-- [CONFIRM] fees page + exact bulk-billed items/eligibility before publishing. -->
        </div>
      </div>
    </section>

    <!-- ===== TRUST & INDEPENDENCE ===== -->
    <section class="trust-sec section" aria-labelledby="trust-h">
      <div class="wrap">
        <div class="trust-head">
          <div>
            <h2 id="trust-h"><span class="hl">Trusted care</span>, owned by doctors</h2>
            <div class="trust-rating">
              <img src="/assets/google-icon.png" alt="Google" width="22" height="22" />
              <strong>{practice.rating}</strong>
              <Icon name="iconoir:star-solid" class="trust-star" />
              <span>from {practice.reviewCount} reviews</span>
            </div>
          </div>
        </div>

        <div class="reviews-masonry" data-reveal-group>
          {[0, 1, 2].map((col) => (
            <ul class={`reviews-col reviews-col-${col + 1}`}>
              {reviews.filter((_, i) => i % 3 === col).map((r, j) => (
                <li class="review-card reveal" style={`--reveal-delay:${col * 130}ms`}>
                  <div class="review-top">
                    <span class="review-name">{r.name}</span>
                    <Icon name="iconoir:quote-solid" class="review-quote" />
                  </div>
                  <span class="review-stars" role="img" aria-label="5 out of 5 stars">
                    <Icon name="iconoir:star-solid" />
                    <Icon name="iconoir:star-solid" />
                    <Icon name="iconoir:star-solid" />
                    <Icon name="iconoir:star-solid" />
                    <Icon name="iconoir:star-solid" />
                  </span>
                  <p class={r.placeholder ? 'review-text is-placeholder' : 'review-text'}>{r.text}</p>
                </li>
              ))}
            </ul>
          ))}
        </div>

        <div class="teaching-card">
          <img
            class="teaching-img"
            src="/assets/reviews/teaching.webp"
            alt=""
            width="760"
            height="620"
            loading="lazy"
            decoding="async"
          />
          <div class="teaching-body">
            <h3 class="teaching-title"><span class="hl">Trusted</span> by doctors &amp; patients</h3>
            <p class="independence">
            MGP is a teaching practice for the University of Melbourne and the RACGP, and our doctors
            regularly participate in ethical medical research. The practice is completely independent,
            with no financial interest in any other service provider within the Centre — so every
              clinical decision and referral is governed solely by your best interests.
            </p>
            <div class="cred-marks">
              <span class="cred-chip"><img src="/assets/UoM-logo.png" alt="University of Melbourne" /></span>
              <span class="cred-chip"><img src="/assets/RACGP-logo.png" alt="RACGP" /></span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== LOCATION ===== -->
    <section class="location-sec section" id="location" aria-labelledby="location-h">
      <div class="wrap location-grid">
        <div class="loc-copy">
          <div class="section-head">
            <h2 id="location-h">Our location</h2>
          </div>

          <div class="loc-address">
            <span class="loc-address-ico"><Icon name="iconoir:building" /></span>
            <span>{practice.address}</span>
          </div>

          <p class="lead loc-intro">
            Our clinic sits on a corner site between High Street and Manningham Road.
            We're reachable by public transport and private car.
          </p>

          <ul class="loc-facts">
            <li>
              <h3>200+ parking spaces</h3>
              <p>Includes undercover parking via the High St entry.</p>
            </li>
            <li>
              <h3>Disabled access available</h3>
              <p>We provide disability access and accessible facilities.</p>
            </li>
            <li>
              <h3>Open 7 days a week</h3>
              <p>Open Mon–Fri 8am–8pm, plus weekends and after hours.</p>
            </li>
          </ul>
        </div>

        <div class="map-panel">
          <iframe
            class="map-embed"
            src={mapEmbed}
            title="Map of Manningham General Practice, 200 High Street, Lower Templestowe"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
          <a class="map-cta" href={practice.mapsUrl} target="_blank" rel="noopener">
            Open in Google Maps <Icon name="iconoir:arrow-up-right" />
          </a>
        </div>
      </div>
    </section>

    <!-- ===== CLOSING CTA ===== -->
    <section class="closing" id="book" aria-labelledby="closing-h">
      <div class="wrap closing-grid">
        <div class="closing-hours-col">
          <h2 id="closing-h">Opening hours</h2>
          <ul class="closing-hours">
            {hours.map((h) => (
              <li><strong>{h.day}</strong> <span>{h.time}</span></li>
            ))}
          </ul>
        </div>

        <div class="closing-cards">
          <a class="cta-card cta-card--book" href={practice.bookingUrl} target="_blank" rel="noopener">
            <span class="cta-ico"><Icon name="iconoir:calendar-plus" /></span>
            <h3>Book online in only a minute</h3>
            <p class="cta-sub">Choose your doctor and time online.</p>
            <span class="btn btn-primary"><Icon name="iconoir:calendar-plus" /> Book online</span>
          </a>
          <a class="cta-card cta-card--call" href={practice.phoneHref}>
            <span class="cta-ico"><Icon name="iconoir:phone" /></span>
            <h3>Prefer to speak to someone? Call us!</h3>
            <p class="cta-sub">Talk to our friendly reception team.</p>
            <span class="btn btn-ghost-light"><Icon name="iconoir:phone" /> {practice.phone}</span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <!-- Persistent booking affordance for phone users -->
  <div class="mobile-cta" aria-label="Quick actions">
    <a href={practice.phoneHref} class="btn btn-secondary">
      <Icon name="iconoir:phone" /> Call
    </a>
    <a href={practice.bookingUrl} class="btn btn-primary" target="_blank" rel="noopener">
      <Icon name="iconoir:calendar-plus" /> Book online
    </a>
  </div>
</Layout>

<style>
  .skip-link {
    position: absolute;
    left: -999px;
    top: 0;
    z-index: 100;
    background: var(--navy);
    color: var(--white);
    padding: 0.75rem 1.25rem;
    border-radius: 0 0 var(--r-sm) 0;
  }
  .skip-link:focus {
    left: 0;
  }

  /* ---------- HERO ---------- */
  .hero {
    position: relative;
    overflow: hidden;
    background: #eaf3f9;
    padding-block: clamp(2.5rem, 5vw, 4.5rem);
  }
  /* The banner artwork carries its own pattern and bleeds off the right edge. */
  .hero-photo {
    display: block;
    width: 100%;
    height: auto;
    margin-top: var(--sp-6);
  }
  .hero-grid {
    position: relative;
    z-index: 2;
  }
  .hero-copy h1 {
    font-size: var(--fs-display);
    font-weight: var(--heading-weight);
    line-height: 1.1;
    letter-spacing: -0.02em;
    max-width: 19ch;
  }
  .hero-copy .hl {
    color: var(--blue);
  }
  .hero-copy .lead {
    margin-top: var(--sp-4);
    max-width: 38ch;
  }
  .hero-points {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3) var(--sp-6);
    margin-top: var(--sp-5);
  }
  /* Booking is the page's job: the CTA pair sits directly under the proof
     points, ahead of the credibility badges. */
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    margin-top: var(--sp-6);
  }
  .hero-actions .btn [data-icon] {
    font-size: 1.15em;
  }
  .hero-points li {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-weight: 600;
    color: var(--navy);
  }
  .hero-points [data-icon] {
    color: var(--blue);
    font-size: 1.1rem;
  }
  .hero-badges {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: var(--sp-4);
    margin-top: var(--sp-7);
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    border-radius: var(--r-pill);
    padding: 0.65rem 1.15rem;
  }
  .badge-google {
    background: var(--white);
    border: 1px solid var(--line);
  }
  .badge-google img {
    width: 26px;
    height: 26px;
  }
  .badge-star {
    color: var(--amber);
    font-size: 1.15rem;
  }
  .badge-google strong {
    color: var(--navy);
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1;
  }
  .badge-reviews {
    color: var(--ink-2);
    font-size: var(--fs-xs);
    line-height: 1.15;
  }
  .badge-teaching {
    background: transparent;
    border: 1px solid var(--blue-300);
    gap: 0.85rem;
  }
  .badge-teaching-label {
    color: var(--navy);
    font-size: 0.9rem;
    font-weight: 500;
    line-height: 1.2;
  }
  .badge-teaching img {
    height: 44px;
    width: auto;
  }

  /* ---------- QUICK ACCESS ---------- */
  .quick {
    padding-block: clamp(2.5rem, 4vw, 3.5rem);
    background: var(--blue);
  }
  .quick-h {
    font-size: var(--fs-h3);
    color: var(--white);
    font-weight: 600;
    margin-bottom: var(--sp-5);
  }
  .quick-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--sp-3);
  }
  .quick-tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--sp-3);
    padding: var(--sp-4);
    border: 2px solid transparent;
    border-radius: var(--r-md);
    background:
      linear-gradient(var(--white), var(--white)) padding-box,
      linear-gradient(var(--line), var(--line)) border-box;
    text-decoration: none;
    height: 100%;
    transition: transform 0.55s var(--ease), background 0.55s var(--ease);
  }
  .quick-tile:hover {
    transform: translateY(-6px);
    background:
      linear-gradient(var(--white), var(--white)) padding-box,
      linear-gradient(135deg, var(--navy), var(--blue) 50%, var(--amber)) border-box;
  }
  .quick-medallion {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    flex-shrink: 0;
    position: relative;
    isolation: isolate;
    border-radius: var(--r-md);
    background: var(--blue-050);
    color: var(--blue);
    font-size: 1.4rem;
    transition: color 0.55s var(--ease);
  }
  .quick-medallion::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: linear-gradient(145deg, var(--navy), var(--blue) 55%, var(--amber));
    opacity: 0;
    transition: opacity 0.55s var(--ease);
  }
  /* Hover inverts the pair: the gradient fades up over the square while the
     icon reverses to white. */
  .quick-tile:hover .quick-medallion::before {
    opacity: 1;
  }
  .quick-tile:hover .quick-medallion {
    color: var(--white);
  }
  .quick-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
  }
  .quick-label {
    font-weight: 600;
    color: var(--navy);
    transition: color 0.55s var(--ease);
  }
  .quick-tile:hover .quick-label {
    color: var(--blue);
  }
  .quick-desc {
    font-size: var(--fs-sm);
    color: var(--ink-3);
  }
  .quick-arrow {
    display: inline-flex;
    margin-top: 2px;
    color: var(--blue);
    font-size: 1.15rem;
    transition: transform 0.55s var(--ease);
  }
  .quick-tile:hover .quick-arrow {
    transform: translateX(3px);
  }

  /* ---------- HOURS ---------- */
  .hours-sec {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background-color: var(--white);
    padding-top: calc(clamp(3rem, 6vw, 5.5rem) * 3.05);
    padding-bottom: calc(clamp(3rem, 6vw, 5.5rem) * 1.1);
  }
  /* Photograph fills the right half of the band; the copy sits on the flat
     tint in the left half. */
  .hours-sec::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 50%;
    z-index: -1;
    background-image: url('/assets/hours-backdrop.webp');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }
  .hours-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: start;
  }
  /* Heading and lead are one statement; the gap between them was zero. */
  .hours-lead h2 {
    font-size: var(--fs-h2);
    max-width: 18ch;
    margin-bottom: var(--sp-4);
  }
  .hours-lead h2 .hl {
    color: var(--blue);
  }
  .hours-lead .lead,
  .billing-line {
    max-width: 46ch;
  }
  .hours-lead .lead {
    font-size: 1rem;
  }
  .hours-flags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    margin-top: var(--sp-4);
  }
  .flag {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.5rem 0.9rem;
    border-radius: var(--r-pill);
    background: var(--white);
    border: 1px solid var(--blue-100);
    color: var(--navy);
    font-weight: 600;
    font-size: var(--fs-sm);
  }
  .flag [data-icon] {
    color: var(--blue);
  }
  .billing-line {
    margin-top: var(--sp-6);
    padding-top: var(--sp-5);
    border-top: 1px solid var(--line);
    color: var(--ink-2);
    font-size: var(--fs-sm);
  }
  .billing-line a {
    color: var(--blue-700);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .hours-card {
    background: var(--white);
    color: var(--ink);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    padding: clamp(1.75rem, 3vw, 2.25rem);
    box-shadow: var(--shadow);
  }
  .hours-card h3 {
    color: var(--navy);
    font-size: var(--fs-h3);
    margin-bottom: var(--sp-5);
  }
  .hours-list {
    margin-bottom: var(--sp-5);
  }
  .hours-list li {
    display: flex;
    justify-content: space-between;
    gap: var(--sp-4);
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--line);
  }
  .hours-list li:last-child {
    border-bottom: none;
  }
  .hours-time {
    font-weight: 600;
    color: var(--blue);
  }

  /* ---------- WHY MGP ---------- */
  /* Section sits on a soft reception-room backdrop; the heading is pushed well
     clear of the cards so the artwork breathes between them. */
  .why {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: #eaf3fa;
  }
  .why::before,
  .why::after {
    content: '';
    position: absolute;
    z-index: -1;
    background-repeat: no-repeat;
    pointer-events: none;
  }
  /* Both motif fields run at 2x scale: the left one is pushed further off the
     viewport so only its shoulder shows, the right one reaches back under the
     cards. */
  .why::before {
    left: -19.4vw;
    bottom: calc(-26vw + 60px);
    width: 71.4vw;
    aspect-ratio: 985 / 676;
    background-image: url('/assets/pattern-left.webp');
    background-size: contain;
    background-position: left bottom;
  }
  .why::after {
    right: -2.65vw;
    top: calc(-7.65vw + 30px);
    width: 24.65vw;
    aspect-ratio: 450 / 451;
    background-image: url('/assets/pattern-right.webp');
    background-size: contain;
    background-position: right top;
  }
  .why .section-head {
    margin-bottom: var(--sp-6);
  }
  .why-cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    margin-top: var(--sp-6);
  }
  .why-wrap {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-6);
    align-items: start;
  }
  .why-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-5);
  }
  .why-item {
    position: relative;
    overflow: hidden;
    height: 100%;
    padding: var(--sp-6) var(--sp-5);
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: calc(var(--r-lg) * 0.9);
    transition: transform 0.96s var(--ease), border-color 0.96s var(--ease);
  }
  /* Two layers displacing at different speeds: a navy→blue sheet descends from
     the top. Card lifts, text goes white. */
  /* Base: a vivid navy→blue→amber gradient revealed through a soft radial mask
     that grows from the corner — a feathered (not hard) bleed that stays vivid
     and keeps white text readable. Blurred colour pools bloom on top for the
     watercolour movement. */
  .why-item::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background: linear-gradient(158deg, var(--navy) 0%, var(--blue) 50%, var(--amber) 126%);
    -webkit-mask-image: radial-gradient(circle at left bottom, #000 34%, transparent 72%);
    mask-image: radial-gradient(circle at left bottom, #000 34%, transparent 72%);
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: left bottom;
    mask-position: left bottom;
    -webkit-mask-size: 0% 0%;
    mask-size: 0% 0%;
    opacity: 0;
    transition: -webkit-mask-size 1.52s var(--ease), mask-size 1.52s var(--ease),
      opacity 1.52s var(--ease);
  }
  .why-item:hover::before {
    -webkit-mask-size: 300% 300%;
    mask-size: 300% 300%;
    opacity: 1;
  }
  .why-item > * {
    position: relative;
    z-index: 1;
  }
  /* Soft colour pools that bloom and bleed into each other like watercolour. */
  .why-bleed {
    position: absolute;
    inset: -30%;
    z-index: 0;
    filter: blur(30px);
    pointer-events: none;
  }
  .wb {
    position: absolute;
    top: 0;
    border-radius: 50%;
    opacity: 0;
    transition: opacity 1.44s var(--ease), transform 1.76s var(--ease);
  }
  .wb-navy {
    width: 80%;
    aspect-ratio: 1 / 1;
    left: -8%;
    background: radial-gradient(circle at 50% 50%, var(--navy) 0%, transparent 66%);
    transform: translateY(-24%) scale(0.4);
  }
  .wb-blue {
    width: 92%;
    aspect-ratio: 1 / 1;
    left: 6%;
    background: radial-gradient(circle at 50% 50%, var(--blue) 0%, transparent 64%);
    transform: translateY(26%) scale(0.4);
    transition-duration: 1.68s, 2s;
  }
  .wb-amber {
    width: 86%;
    aspect-ratio: 1 / 1;
    left: 4%;
    background: radial-gradient(circle at 50% 50%, var(--amber) 0%, transparent 60%);
    transform: translateY(78%) scale(0.4);
    transition-duration: 1.92s, 2.32s;
  }
  .why-item:hover .wb {
    opacity: 0.7;
  }
  .why-item:hover .wb-navy {
    transform: translateY(-20%) scale(1.15);
  }
  .why-item:hover .wb-blue {
    transform: translateY(24%) scale(1.25);
  }
  .why-item:hover .wb-amber {
    transform: translateY(72%) scale(1.3);
  }
  .why-item:hover {
    transform: translateY(-8px);
    border-color: transparent;
  }
  .why-ico {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: var(--r-md);
    background: var(--blue-050);
    color: var(--blue);
    font-size: 1.6rem;
    margin-bottom: var(--sp-4);
    transition: background-color 0.64s var(--ease), color 0.64s var(--ease);
  }
  .why-item:hover .why-ico {
    background: rgba(255, 255, 255, 0.16);
    color: var(--white);
  }
  .why-item h3 {
    font-size: var(--fs-h3);
    margin-bottom: var(--sp-5);
    transition: color 0.64s var(--ease);
  }
  .why-item p {
    color: var(--ink-2);
    transition: color 0.64s var(--ease);
  }
  .why-item:hover h3 {
    color: var(--white);
  }
  .why-item:hover p {
    color: var(--on-navy);
  }

  /* ---------- DOCTORS ---------- */
  .doctor-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--sp-3);
  }
  /* Stacked card: portrait on top, name and languages beneath. The whole card
     is the link to that doctor's profile. */
  .doc-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: var(--sp-5);
    border: 2px solid transparent;
    border-radius: var(--r-md);
    background:
      linear-gradient(var(--white), var(--white)) padding-box,
      linear-gradient(var(--line), var(--line)) border-box;
    text-decoration: none;
    transition: transform 0.55s var(--ease), background 0.55s var(--ease);
  }
  .doc-photo {
    display: block;
    width: 64px;
    height: 64px;
    flex-shrink: 0;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid transparent;
    background:
      linear-gradient(var(--blue-050), var(--blue-050)) padding-box,
      linear-gradient(135deg, transparent, transparent) border-box;
    transition: background 0.55s var(--ease);
  }
  .doc-card:hover .doc-photo {
    background:
      linear-gradient(var(--blue-050), var(--blue-050)) padding-box,
      linear-gradient(135deg, var(--blue), var(--amber)) border-box;
  }
  .doc-info {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
    flex: 1;
  }
  /* The visible affordance that each card leads somewhere. */
  .doc-more {
    margin-top: auto;
    padding-top: var(--sp-3);
    color: var(--blue);
    font-size: 1rem;
  }
  .doc-card .doc-more,
  .doc-card .doc-more [data-icon] {
    color: var(--blue);
  }
  .doc-card .doc-more {
    font-size: 1rem;
  }
  .doc-card:hover .doc-more [data-icon] {
    transform: translateX(3px) rotate(45deg);
  }
  .doc-card:hover {
    transform: translateY(-6px);
    background:
      linear-gradient(var(--white), var(--white)) padding-box,
      linear-gradient(135deg, var(--navy), var(--blue) 50%, var(--amber)) border-box;
  }
  .doc-name {
    display: block;
    font-weight: 600;
    color: var(--navy);
    font-size: 1.25rem;
    line-height: 1.2;
  }
  .doc-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--sp-3);
    margin-bottom: var(--sp-3);
  }
  /* The documented language chip: white pill, pale-blue border. */
  .doc-lang {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    padding: 0.2rem 0.55rem;
    background: var(--white);
    border: 1px solid var(--blue-100);
    border-radius: var(--r-pill);
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--ink-2);
    line-height: 1.25;
  }
  .doc-hello {
    color: var(--blue-700);
    font-weight: 800;
  }
  /* Brand-blue band: the heading and lead reverse to white; the doctor cards
     stay white so their navy text is unaffected. */
  .doctors-sec {
    background: var(--blue);
  }
  #doctors-h {
    color: var(--white);
  }
  .doctors-sec .section-head .lead {
    color: var(--on-navy);
  }
  .doctors-more {
    display: flex;
    justify-content: center;
    margin-top: var(--sp-6);
  }
  .fine {
    font-size: var(--fs-sm);
    color: var(--ink-3);
  }

  /* ---------- SERVICES ---------- */
  /* The section headline is led by the "one roof" motif. */
  .services-head {
    display: flex;
    align-items: center;
    gap: var(--sp-5);
    margin-bottom: var(--sp-8);
  }
  .services-motif {
    flex-shrink: 0;
    width: clamp(4rem, 8vw, 7rem);
    height: auto;
  }
  .services-head .hl {
    color: var(--blue);
  }

  /* Each category owns a headline led by a coloured brand motif, so the
     categories read as separate chapters instead of grid cells. */
  .svc-group + .svc-group,
  .spec-group,
  .partners {
    margin-top: var(--sp-9);
  }
  .sg-head {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    margin-bottom: 0;
  }
  .sg-head svg {
    flex-shrink: 0;
  }
  .sg-head h3 {
    font-size: 1.5625rem;
    font-weight: 400;
    letter-spacing: 0;
  }
  .sg-note {
    color: var(--ink-2);
    font-size: var(--fs-sm);
    margin: var(--sp-3) 0 0;
    line-height: 1.5;
    max-width: var(--measure);
  }
  /* Category headings sit well clear of their cards. */
  .svc-cards,
  .spec-cards,
  .partner-list {
    margin-top: 2.25rem;
  }

  /* One small, uniform card per service. */
  .svc-cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--sp-4);
  }
  .svc-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    overflow: hidden;
    text-decoration: none;
    transition: transform 0.33s var(--ease);
  }
  .svc-card:hover {
    transform: translateY(-4px);
  }
  .svc-img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: var(--blue-050);
  }
  .svc-ico {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    flex-shrink: 0;
    border-radius: var(--r-sm);
    background: var(--blue-050);
    color: var(--blue);
    font-size: 0.95rem;
    transition: background 0.5s var(--ease), color 0.5s var(--ease);
  }
  .svc-label {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    padding: var(--sp-4) var(--sp-3);
    color: var(--navy);
    font-weight: 600;
    line-height: 1.25;
  }
  /* Same feathered gradient bleed as the "more than a referral" cards: a
     navy→blue→amber sheet revealed through a soft radial mask. */
  .svc-label::before {
    content: '';
    position: absolute;
    /* Oversized and blurred so the leading edge of the sweep feathers into the
       bar instead of cutting a hard arc across it. */
    inset: -40%;
    filter: blur(16px);
    z-index: -1;
    background: linear-gradient(158deg, var(--navy) 0%, var(--blue) 50%, var(--amber) 126%);
    -webkit-mask-image: radial-gradient(circle at left bottom, #000 34%, transparent 72%);
    mask-image: radial-gradient(circle at left bottom, #000 34%, transparent 72%);
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: left bottom;
    mask-position: left bottom;
    -webkit-mask-size: 0% 0%;
    mask-size: 0% 0%;
    opacity: 0;
    transition: -webkit-mask-size 1s var(--ease), mask-size 1s var(--ease),
      opacity 1s var(--ease);
  }
  .svc-card:hover .svc-label::before {
    -webkit-mask-size: 300% 300%;
    mask-size: 300% 300%;
    opacity: 1;
  }
  .svc-card:hover .svc-label,
  .svc-card:hover .svc-name {
    color: var(--white);
  }
  .svc-card:hover .svc-label > [data-icon] {
    color: var(--white);
  }
  .svc-card:hover .svc-ico {
    background: rgba(255, 255, 255, 0.16);
    color: var(--white);
  }
  .svc-name {
    flex: 1;
    transition: color 0.5s var(--ease);
  }
  .svc-label > [data-icon] {
    flex-shrink: 0;
    margin-top: 0.1em;
    color: var(--blue);
    font-size: 1.1rem;
    transform: rotate(-45deg);
    transition: transform 0.5s var(--ease), color 0.5s var(--ease);
  }
  .svc-card:hover .svc-label > [data-icon] {
    transform: translateX(3px) rotate(0deg);
  }

  /* Specialist clinics: large solid-colour tiles led by a big icon. Each tone
     is dark enough to carry white text at AA; the button reverses to white so
     amber stays reserved for the page's one booking action. */
  /* Single column on phones; the 40px page-edge inset is a wide-screen move. */
  .spec-cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.5rem;
    padding-inline: clamp(1.1rem, 4vw, 2.5rem);
  }
  @media (min-width: 560px) {
    .spec-cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .spec-group .wrap {
    padding-inline: clamp(1.1rem, 4vw, 2.5rem);
  }
  .services-sec {
    overflow-x: clip;
  }
  /* Each clinic's hue reads at the top of the card and settles into the brand
     navy at the base, so the four tiles stay one family. */
  .spec-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    height: 100%;
    padding: 1.75rem;
    border-radius: 0.25rem;
    color: var(--white);
    background-color: var(--tone);
    background-image: linear-gradient(135deg, var(--tone-light) 0%, var(--tone) 42%, var(--navy) 108%);
    background-size: 100% 175%;
    background-position: 50% 0%;
    transition: background-position 0.7s var(--ease), border-radius 0.7s var(--ease);
  }
  .spec-card:hover {
    background-position: 50% 100%;
    border-radius: var(--r-lg);
  }
  .spec-purple {
    --tone-light: #9070c2;
    --tone: #6d4a9c;
    --tone-soft: #d9c7f2;
    --tone-deep: #4a2d73;
  }
  .spec-green {
    --tone-light: #4f9773;
    --tone: #2f6d50;
    --tone-soft: #bcd9c9;
    --tone-deep: #1f4a35;
  }
  .spec-pink {
    --tone-light: #ca5f92;
    --tone: #a63a6c;
    --tone-soft: #f7b3d2;
    --tone-deep: #7a2249;
  }
  .spec-orange {
    --tone-light: #dd8541;
    --tone: #b45c1e;
    --tone-soft: #f8cb9c;
    --tone-deep: #7b3c10;
  }
  .spec-ico {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 0.625rem;
    background: var(--tone-soft);
    color: var(--tone-deep);
    font-size: 1.75rem;
    margin-bottom: 4.25rem;
  }
  .spec-name {
    font-size: clamp(1.35rem, 1.15rem + 0.8vw, 1.65rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--white);
    margin-bottom: var(--sp-3);
  }
  .spec-body {
    color: rgba(255, 255, 255, 0.9);
    font-size: var(--fs-sm);
    line-height: 1.55;
    margin-bottom: 2.25rem;
  }
  .spec-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--sp-4);
    width: 100%;
    margin-top: auto;
  }

  /* Underlined amber text link — the "read more" voice, distinct from the
     amber Book button that carries the booking action. */
  .link-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--amber);
    font-size: 1.0625rem;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }
  /* On light cards the link reverses to navy with a brand-blue arrow. */
  .link-cta-navy {
    color: var(--navy);
  }
  .link-cta-navy [data-icon] {
    color: var(--blue);
  }
  /* ...and on the dark blue partner cards, white with a light-blue arrow. */
  .link-cta-light {
    color: var(--white);
  }
  .link-cta-light [data-icon] {
    color: var(--blue-100);
  }
  .link-cta [data-icon] {
    transition: transform 0.5s var(--ease);
  }
  .link-cta:hover [data-icon] {
    transform: translateX(3px) rotate(45deg);
  }

  /* Partner clinics sit directly on the band — no card container. The image
     leads, the copy and the off-site action sit beneath it. */
  .partner-list {
    display: grid;
    gap: 5rem;
  }
  .partner-card {
    display: block;
    height: 100%;
    padding: 10px;
    border: 1px solid transparent;
    border-radius: 1.25rem;
